{
  "name": "claude-swarm",
  "productName": "Claude Swarm",
  "version": "0.1.0",
  "description": "Run and watch many Claude Code sessions side by side, from one window and a tray icon.",
  "main": "src/main.js",
  "author": "Claude Swarm",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.claudeswarm",
    "productName": "Claude Swarm",
    "directories": { "output": "dist" },
    "files": ["src/**", "assets/**", "package.json"],
    "asarUnpack": ["src/mcp-server.js"],
    "win": { "target": ["portable"], "icon": "assets/icon.ico" },
    "portable": { "artifactName": "ClaudeSwarm-${version}.exe" },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }, { "target": "zip", "arch": ["arm64", "x64"] }],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "ClaudeSwarm-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Development",
      "maintainer": "Claude Swarm <noreply@example.com>",
      "artifactName": "ClaudeSwarm-${version}-${arch}.${ext}"
    }
  }
}
